# Plantilla de variables del frontend.
# Copiar a `.env` si se necesita cambiar el destino de la API.

# Vacío = usa el proxy de Vite (/api -> http://127.0.0.1:5000).
# Con valor = el navegador llama a esa URL directamente; en ese caso el origen
# del frontend debe estar en CORS_ORIGINS2 del backend.
VITE_API_BASE_URL=

# Puerto y host del servidor de desarrollo.
VITE_DEV_PORT=5173
VITE_DEV_HOST=127.0.0.1
