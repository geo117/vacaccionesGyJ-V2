# Plantilla de configuración del backend.
# Copiar a `.env` y completar los valores. `.env` NO se versiona.

# --- Conexión a SQL Server -------------------------------------------------
DB_SERVER2=.\SQLEXPRESS
DB_NAME2=BD_Integraciones
DB_USER2=usuario_python
DB_PASSWORD2=cambiar_esta_contrasena
DB_DRIVER2={ODBC Driver 17 for SQL Server}

# Cifrado de la conexión ODBC. El driver 17 cifra por defecto.
# Contra un servidor remoto: DB_ENCRYPT2=yes y DB_TRUST_SERVER_CERT2=no, con un
# certificado válido emitido por una CA en la que el cliente confíe.
DB_ENCRYPT2=yes
DB_TRUST_SERVER_CERT2=yes
DB_TIMEOUT_SECONDS2=5

# --- Segunda conexión: vista corporativa de colaboradores ------------------
# Estas variables van SIN sufijo: son la otra base. Es OPCIONAL: si falta, el
# backend arranca igual y /api/asignaciones degrada al listado local.
#
# Sobre esta vista SÓLO se leen datos. No hace falta (ni conviene) un usuario
# administrador: basta con uno que tenga SELECT sobre la vista.
DB_SERVER=10.0.0.0
DB_NAME=BD_Integraciones
DB_USER=usuario_de_solo_lectura
DB_PASSWORD=cambiar_esta_contrasena
DB_DRIVER={ODBC Driver 17 for SQL Server}
DB_ENCRYPT=yes
# 'no' en cuanto haya un certificado válido: con 'yes' la conexión cifra pero no
# comprueba con quién habla.
DB_TRUST_SERVER_CERT=yes
DB_TIMEOUT_SECONDS=8

# --- Servidor HTTP ---------------------------------------------------------
PORT2=5000
# 127.0.0.1 = solo esta máquina. 0.0.0.0 publica la API a la red local.
HOST2=127.0.0.1

# NUNCA 'True' en producción ni en desarrollo compartido: el depurador de
# Werkzeug ejecuta código arbitrario desde el navegador (SEC-17).
DEBUG2=False

# --- CORS ------------------------------------------------------------------
# Orígenes exactos, separados por coma. Nunca '*'.
CORS_ORIGINS2=http://localhost:5173,http://127.0.0.1:5173

# --- Sesiones --------------------------------------------------------------
SESSION_TTL_SECONDS2=28800
SESSION_IDLE_SECONDS2=1800
# Obligatorio, mínimo 32 caracteres. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_PEPPER2=

# --- Límite de intentos de login por (IP + correo) -------------------------
LOGIN_MAX_ATTEMPTS2=5
LOGIN_WINDOW_SECONDS2=900

# --- Registro --------------------------------------------------------------
LOG_LEVEL2=INFO
